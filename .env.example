# Salin ke .env.local untuk pengembangan lokal, atau isi di Vercel → Settings → Environment Variables.
# Buat nilai AUTH_PASSWORD_HASH dan SESSION_SECRET dengan:  npm run hash -- "kata sandi Anda"
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Akun demo (dummy/dummy) aktif bawaan. Isi off untuk mematikannya.
# DEMO_LOGIN=off
